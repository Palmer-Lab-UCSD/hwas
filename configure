#!/bin/sh
#
# The point of this configure script is to:
#
#   * Collect requisite htslib compilation parameters
#   * verify that htslib can be linked to,
#   * write the src/Makevars from src/Makevars.in so that R's native
#     Makefile builds the package with the required settings
#
# These steps are delimited by sectioning lines '##############' and
# with details specified in subsequent section comments.  
#
# AI Desclaimer: Claude Opus 5, an AI from Anthropic, was consulted
# for this script.  Each step of this configure script has been
# either ideated or reviewed by myself.

set -u

fatal() {
    printf "Error in configure %s\n" "$1" >&2
    exit 1
}


########################################################################
# collect htslib compilation parameters
#
# The R package must dynamically link to a shared htslib library file.
# Therefore we need to tell R where to find htslib header and library
# files.  These parameters can be stored and retrieved using pkg-config
# or the environment variables HTSLIB_CPATH and HTSLIB_LIB_PATH.  The
# results from pkg-config take precedence over environment variables.
#
# Note, because we dynamically link to htslib, the location of the
# library file must be known at runtime.  From Claude's recommendation
# this is done by setting the htslib library path in the R package
# shared library file, e.g. .so file on Linux.  These parameters are
# set using -Wl,-rpath,<path>.


hts_cflags=""
hts_libs=""

if [ -n "${HTSLIB_CPATH-}" ]; then
    # using IFS to separate path elemetns  was Claude's idea
    saved_ifs=$IFS
    IFS=':'
    # turn off glob expansion of paths, undo by set +f
    # as is done after the loop, also claude's idea
    set -f
    for w in $HTSLIB_CPATH; do
        [ -n "$w" ] || continue
        [ -d "$w" ] || fatal "$w is not a directory."
        [ -x "$w" ] || fatal "$w permission error."
        hts_cflags="${hts_cflags}${hts_cflags:+ }-I${w}"
    done
    set +f
    IFS=$saved_ifs
fi

if [ -n "${HTSLIB_LIB_PATH-}" ]; then
    saved_ifs=$IFS
    IFS=':'
    set -f
    for w in $HTSLIB_LIB_PATH; do
        [ -n "$w" ] || continue
        [ -d "$w" ] || fatal "$w is not a directory."
        [ -x "$w" ] || fatal "$w permission error."
        hts_libs="${hts_libs}${hts_libs:+ }-L${w} -Wl,-rpath,${w}"
    done
    set +f
    IFS=$saved_ifs
    hts_libs="${hts_libs} -lhts"
fi


# Claude recommended command -v pkg-config to verify that pkg-config
# program exists
if command -v pkg-config >/dev/null && pkg-config --exists htslib; then
    hts_cflags="$(pkg-config --cflags htslib)"
    hts_lib_dir="$(pkg-config --variable=libdir htslib)"
    [ -n "$hts_lib_dir" ] || fatal "htslib.pc returns no libdir"
    hts_libs="-L${hts_lib_dir} -Wl,-rpath,${hts_lib_dir} -lhts"
    echo "Using htslib settings specified by pkg-config"
    printf "hts_cflags\t%s\n" "${hts_cflags}"
    printf "hts_libs\t%s\n" "${hts_libs}"
elif [ -n "$hts_cflags" ] && [ -n "$hts_libs" ]; then
    echo "Using htslib settings specified by environment variables"
    printf "hts_cflags\t%s\n" "${hts_cflags}"
    printf "hts_libs\t%s\n" "${hts_libs}"
else 
    fatal "htslib settings are either not found or not valid."
fi

########################################################################
# verify compilation 
#
# To verify htslib can be linked to I compile a small C++ program
# written as a "here doc" below.  The compiler settings need to be
# the same as R's native build system.  These parameters can be 
# retrived using R CMD config <param_name>.

if [ -f conftest.cpp ] || [ -f conftest ]; then
    echo "Unexpectedly, the conftest.cpp and conftest executable already"
    echo "exist.  Either rename/ remove these files or connect with the"
    echo "maintainer about the issue."
    exit 1
fi

cat > conftest.cpp << 'EOF'
#include <htslib/vcf.h>

int main() {
    bcf1_t* brec = bcf_init();
    if (brec == nullptr) return -1;
    bcf_destroy(brec);
    return 0;
}
EOF

: "${R_HOME:=$(R RHOME)}"
[ -n "$R_HOME" ] || fatal "Couln't find R"

R_bin="${R_HOME}/bin/R"
[ -x "$R_bin" ] || fatal "not executable, $R_bin"

cxx_c=$("${R_bin}" CMD config CXX17)
cxx_standard=$("${R_bin}" CMD config CXX17STD)
cxx_flags=$("${R_bin}" CMD config CXX17FLAGS)

$cxx_c $cxx_standard $cxx_flags $hts_cflags -o conftest conftest.cpp $hts_libs
status=$?
[ -f conftest.cpp ] && rm conftest.cpp
[ $status -eq 0 ] || fatal "Could not build"

./conftest
status=$?
[ -f conftest ] && rm conftest
[ $status -eq 0 ] || fatal "Could not run"


########################################################################
# write Makevars file by string substitution

[ -f "src/Makevars.in" ] || fatal "No src/Makevars.in file found"

cxx_std="CXX17"

sed -e "s|@htslib_cflags@|${hts_cflags}|g" \
    -e "s|@htslib_libs@|${hts_libs}|g" \
    -e "s|@cxx_standard@|${cxx_std}|g" \
    src/Makevars.in > src/Makevars


